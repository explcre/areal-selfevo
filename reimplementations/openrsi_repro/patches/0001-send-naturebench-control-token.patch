+# --- LOCAL MODIFICATION, NOT UPSTREAM -------------------------------------------------
+# NatureBench commit d38eb9c (2026-08-28, "protect control endpoints with service token")
+# gates POST /register, /start_timer, /resume_timer and /pause_timer behind the header
+# X-NatureBench-Control-Token, answering 404 "unknown endpoint" when it is absent so the
+# endpoints stay hidden from model-generated code. OpenRSI at commit 1f477c48 never sends
+# that header, so its documented NatureBench quickstart cannot register a task against
+# NatureBench at or after d38eb9c. This helper supplies the token. It is our change, not
+# the authors'; see reimplementations/openrsi_repro/RUNG0.md.
+NATUREBENCH_CONTROL_TOKEN_HEADER = "X-NatureBench-Control-Token"
+
+
+def _load_naturebench_control_token() -> str:
+    """Return the NatureBench eval-service control token, or an empty string.
+
+    Reads NATUREBENCH_CONTROL_TOKEN, else the file named by
+    NATUREBENCH_CONTROL_TOKEN_PATH. Returns "" rather than raising, so a deployment whose
+    service does not gate control endpoints behaves exactly as before this patch.
+    """
+    token = os.environ.get("NATUREBENCH_CONTROL_TOKEN", "").strip()
+    if token:
+        return token
+    path = os.environ.get("NATUREBENCH_CONTROL_TOKEN_PATH", "").strip()
+    if not path:
+        return ""
+    try:
+        return Path(path).read_text(encoding="utf-8").strip()
+    except OSError:
+        return ""
+# --- END LOCAL MODIFICATION -----------------------------------------------------------
+
+
